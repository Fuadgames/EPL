rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        || (signedIn() && request.auth.uid == userId
            && request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'));
    }
    match /apps/{appId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        || (signedIn()
            && request.resource.size < 20 * 1024 * 1024
            && request.resource.contentType.matches('image/.*|application/zip'));
    }
    match /{allPaths=**} { 
      allow read, write: if false; 
    }
  }
}
