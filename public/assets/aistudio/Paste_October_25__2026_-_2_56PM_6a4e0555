---------------- 4.1 firestore.rules (залить как есть) ----------------

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function verified()  { return signedIn() && request.auth.token.email_verified == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin()   { return signedIn() && request.auth.token.admin == true; }

    // ---------- users ----------
    match /users/{userId} {
      allow get:    if isSelf(userId) || isAdmin();
      allow list:   if isAdmin();

      // создать можно только себя и только «пустого» пользователя
      allow create: if isSelf(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.isPremium == false
                    && request.resource.data.eplCoins == 0
                    && request.resource.data.get('premiumExpiry', null) == null
                    && request.resource.data.get('permissions', []) == []
                    && request.resource.data.get('isBanned', false) == false;

      // обновление: себе — только безопасные поля, админу — всё
      allow update: if isAdmin()
                    || (isSelf(userId) && verified()
                        && request.resource.data.role           == resource.data.role
                        && request.resource.data.isPremium      == resource.data.isPremium
                        && request.resource.data.premiumExpiry  == resource.data.premiumExpiry
                        && request.resource.data.eplCoins       == resource.data.eplCoins
                        && request.resource.data.permissions    == resource.data.permissions
                        && request.resource.data.isBanned       == resource.data.isBanned
                        && request.resource.data.uid            == resource.data.uid);

      allow delete: if isAdmin();
    }

    // ---------- users_public ----------
    match /users_public/{userId} {
      allow get:  if signedIn();
      allow list: if signedIn();
      allow create, update: if isAdmin()
        || (isSelf(userId) && verified()
            && request.resource.data.uid == userId
            && request.resource.data.eplCoins == resource.data.get('eplCoins', 0));
      allow delete: if isAdmin();
    }

    // ---------- apps ----------
    match /apps/{appId} {
      allow get, list: if signedIn();
      allow create: if verified()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (verified()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isAdmin()
        || (verified() && resource.data.authorId == request.auth.uid);
    }

    // ---------- assets ----------
    match /assets/{assetId} {
      allow get, list: if signedIn();
      allow create: if verified() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (verified() && resource.data.authorId == request.auth.uid);
    }

    // ---------- premium_codes: клиенту закрыто полностью ----------
    match /premium_codes/{codeId} {
      allow read, write: if false;   // только Admin SDK
    }

    // ---------- adminRequests ----------
    match /adminRequests/{reqId} {
      allow create: if verified()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // всё остальное — запрещено
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

---------------- 4.2 storage.rules ----------------

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        || (signedIn() && request.auth.uid == userId
            && request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'));
    }
    match /apps/{appId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        || (signedIn()
            && request.resource.size < 20 * 1024 * 1024
            && request.resource.contentType.matches('image/.*|application/zip'));
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

---------------- 4.3 Cloud Functions (Node.js, 2nd gen) ----------------

// functions/index.js
const { onCall, HttpsError } = require('firebase-functions/v2/https');
const { onDocumentCreated } = require('firebase-functions/v2/firestore');
const { initializeApp } = require('firebase-admin/app');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const { getAuth } = require('firebase-admin/auth');
const crypto = require('crypto');

initializeApp();
const db = getFirestore();
const auth = getAuth();

const guard = (req, needAdmin = false) => {
  if (!req.auth) throw new HttpsError('unauthenticated', 'auth required');
  if (!req.auth.token.email_verified) throw new HttpsError('permission-denied', 'verify email');
  if (needAdmin && req.auth.token.admin !== true) throw new HttpsError('permission-denied', 'admin only');
  return req.auth;
};

// --- выдать/снять админа (только владелец через консоль или уже админ)
exports.setRole = onCall(async (req) => {
  const me = guard(req, true);
  const { uid, role } = req.data || {};
  if (!['user', 'moderator', 'admin'].includes(role)) throw new HttpsError('invalid-argument', 'bad role');
  await auth.setCustomUserClaims(uid, { admin: role === 'admin', moderator: role === 'moderator' });
  await db.doc(`users/${uid}`).update({ role });
  await db.collection('audit').add({
    type: 'role_change', by: me.uid, target: uid, role, at: FieldValue.serverTimestamp(),
  });
  return { ok: true };
});

// --- коины: только сервер, с проверкой баланса
exports.giveCoins = onCall(async (req) => {
  const me = guard(req, true);
  const { uid, amount } = req.data || {};
  if (!Number.isInteger(amount) || Math.abs(amount) > 1e6) throw new HttpsError('invalid-argument', 'bad amount');
  await db.runTransaction(async (tx) => {
    const ref = db.doc(`users/${uid}`);
    const snap = await tx.get(ref);
    if (!snap.exists) throw new HttpsError('not-found', 'user');
    const next = Math.max(0, (snap.data().eplCoins || 0) + amount);
    tx.update(ref, { eplCoins: next });
    tx.set(db.collection('audit').doc(), {
      type: 'coins', by: me.uid, target: uid, amount, at: FieldValue.serverTimestamp(),
    });
  });
  return { ok: true };
});

// --- генерация премиум-кода: сервер, хеш вместо открытого текста
exports.generatePremiumCode = onCall(async (req) => {
  const me = guard(req, true);
  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  const part = () => Array.from(crypto.randomBytes(4))
    .map(b => alphabet[b % alphabet.length]).join('').slice(0, 4);
  const code = `${part()}-${part()}-${part()}`;
  const hash = crypto.createHash('sha256').update(code).digest('hex');
  await db.doc(`premium_codes/${hash}`).set({
    used: false, createdAt: FieldValue.serverTimestamp(), createdBy: me.uid,
  });
  return { code }; // показывается один раз, в базе только хеш
});

// --- активация кода: сервер, атомарно, с проверкой «не использован»
exports.redeemPremiumCode = onCall(async (req) => {
  const me = guard(req);
  const code = String(req.data?.code || '').trim().toUpperCase();
  const hash = crypto.createHash('sha256').update(code).digest('hex');
  const ref = db.doc(`premium_codes/${hash}`);
  await db.runTransaction(async (tx) => {
    const snap = await tx.get(ref);
    if (!snap.exists) throw new HttpsError('not-found', 'invalid code');
    if (snap.data().used) throw new HttpsError('already-exists', 'code used');
    const until = new Date(Date.now() + 365 * 24 * 3600 * 1000).toISOString();
    tx.update(ref, { used: true, usedBy: me.uid, usedAt: FieldValue.serverTimestamp() });
    tx.update(db.doc(`users/${me.uid}`), { isPremium: true, premiumExpiry: until });
    tx.set(db.collection('audit').doc(), {
      type: 'premium_redeem', by: me.uid, at: FieldValue.serverTimestamp(),
    });
  });
  return { ok: true };
});

// --- проверка сессии оплаты: HMAC-подпись вместо голого session_id
exports.verifySession = onCall(async (req) => {
  const me = guard(req);
  const { sessionId, signature } = req.data || {};
  const expected = crypto.createHmac('sha256', process.env.SESSION_SECRET)
    .update(`${me.uid}:${sessionId}`).digest('hex');
  if (!crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(String(signature || '').padEnd(expected.length).slice(0, expected.length)))) {
    throw new HttpsError('permission-denied', 'bad signature');
  }
  const snap = await db.doc(`sessions/${sessionId}`).get();
  if (!snap.exists || snap.data().uid !== me.uid) throw new HttpsError('not-found', 'session');
  return { premiumCode: snap.data().premiumCode, status: snap.data().status };
});

// --- первичная инициализация профиля: сервер сам ставит role
exports.onUserCreate = require('firebase-functions/v2/identity').beforeUserCreated(async (event) => {
  const u = event.data;
  await db.doc(`users/${u.uid}`).set({
    uid: u.uid, email: u.email || '', name: u.displayName || 'User',
    role: 'user', isPremium: false, premiumExpiry: null, eplCoins: 0,
    permissions: [], isBanned: false, createdAt: FieldValue.serverTimestamp(),
  }, { merge: true });
});

