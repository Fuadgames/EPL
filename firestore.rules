rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-.]+$');
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isBootstrappedDev() {
      return signedIn()
        && request.auth.token.email == 'fufazada@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function callerRole() {
      return (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user')
        : 'user';
    }

    function isAdmin() {
      return isBootstrappedDev() || (signedIn() && callerRole() in ['admin', 'developer']);
    }

    function isStaff() {
      return isAdmin() || (signedIn() && callerRole() in ['moderator', 'admin', 'developer']);
    }

    function isDeveloper() {
      return isBootstrappedDev() || (signedIn() && callerRole() == 'developer');
    }

    function callerHasPremium() {
      return isDeveloper() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isPremium', false) == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premiumTier', 'none') in ['plus', 'premium', 'ultra']
        )
      );
    }

    function isValidNewsImages(imgs) {
      return imgs is list
        && imgs.size() <= 6
        && (imgs.size() < 1 || (imgs[0] is string && imgs[0].size() > 0 && imgs[0].size() <= 150000))
        && (imgs.size() < 2 || (imgs[1] is string && imgs[1].size() > 0 && imgs[1].size() <= 150000))
        && (imgs.size() < 3 || (imgs[2] is string && imgs[2].size() > 0 && imgs[2].size() <= 150000))
        && (imgs.size() < 4 || (imgs[3] is string && imgs[3].size() > 0 && imgs[3].size() <= 150000))
        && (imgs.size() < 5 || (imgs[4] is string && imgs[4].size() > 0 && imgs[4].size() <= 150000))
        && (imgs.size() < 6 || (imgs[5] is string && imgs[5].size() > 0 && imgs[5].size() <= 150000));
    }

    function isValidNews(data, expectedId) {
      return data.keys().hasAll(['id', 'title', 'content', 'font', 'images', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'content', 'font', 'images', 'authorId', 'authorName', 'authorAvatar', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == expectedId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() > 0 && data.content.size() <= 25000
        && data.font in ['sans', 'serif', 'mono', 'display', 'cursive']
        && isValidNewsImages(data.images)
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 2048))
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['appId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && data.appId is string && data.appId.size() > 0 && data.appId.size() <= 128
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidPremiumChat(data, expectedUid) {
      return data.keys().hasAll(['userId', 'userName', 'lastMessage', 'lastMessageAt'])
        && data.userId is string && data.userId == expectedUid
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
        && data.lastMessage is string && data.lastMessage.size() <= 4000
        && data.lastMessageAt is string && data.lastMessageAt.size() > 0 && data.lastMessageAt.size() <= 64;
    }

    function isValidPremiumChatMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'senderRole', 'text', 'createdAt'])
        && data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
        && data.senderRole in ['user', 'developer']
        && data.text is string && data.text.size() > 0 && data.text.size() <= 4000
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidRemoteSession(data, targetUid) {
      return data.keys().hasAll(['targetUid', 'controllerUid', 'controllerName', 'status', 'updatedAt'])
        && data.targetUid is string && data.targetUid == targetUid
        && data.controllerUid is string && data.controllerUid.size() > 0 && data.controllerUid.size() <= 128
        && data.controllerName is string && data.controllerName.size() > 0 && data.controllerName.size() <= 100
        && data.status in ['active', 'declined', 'ended']
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidTrollInbox(data, targetUid) {
      return data.keys().hasAll(['eventId', 'targetUid', 'senderUid', 'kind', 'createdAt'])
        && data.eventId is string && data.eventId.size() > 0 && data.eventId.size() <= 128
        && data.targetUid is string && data.targetUid == targetUid
        && data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128
        && data.kind in ['troll_message', 'prank_fx', 'soundboard', 'clear']
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    function isValidEplShopItem(data, expectedId) {
      return data.keys().hasAll(['id', 'title', 'price', 'stock', 'authorId', 'authorName', 'spec', 'status', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == expectedId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && (!('description' in data) || (data.description is string && data.description.size() <= 4000))
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 900000))
        && (!('screenshotUrl' in data) || (data.screenshotUrl is string && data.screenshotUrl.size() <= 900000))
        && data.price is number && data.price >= 0
        && (data.stock == 'infinite' || (data.stock is number && data.stock >= 0))
        && (!('sales' in data) || (data.sales is number && data.sales >= 0))
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && data.spec is map
        && data.status in ['active', 'draft', 'archived']
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) && signedIn() && (isSelf(userId) || isStaff());
      allow update: if isValidId(userId) && signedIn();
      allow delete: if isValidId(userId) && (isStaff() || isSelf(userId));
    }

    // ---------- users_public ----------
    match /users_public/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update, delete: if isValidId(userId) && (isStaff() || isSelf(userId));
    }

    // ---------- apps ----------
    match /apps/{appId} {
      allow get: if isValidId(appId);
      allow list: if true;
      allow create: if isValidId(appId) && signedIn() && (isStaff() || request.resource.data.get('authorId', '') == request.auth.uid);
      allow update: if isValidId(appId) && (
        isStaff()
        || (signedIn() && resource.data.get('authorId', '') == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'downloads', 'visits', 'comments', 'rating', 'updatedAt']))
      );
      allow delete: if isValidId(appId) && (isStaff() || (signedIn() && resource.data.get('authorId', '') == request.auth.uid));
    }

    // ---------- assets ----------
    match /assets/{assetId} {
      allow get: if isValidId(assetId);
      allow list: if true;
      allow create: if isValidId(assetId) && signedIn() && (isStaff() || request.resource.data.get('authorId', '') == request.auth.uid);
      allow update: if isValidId(assetId) && (
        isStaff()
        || (signedIn() && resource.data.get('authorId', '') == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'downloads', 'likes']))
      );
      allow delete: if isValidId(assetId) && (isStaff() || (signedIn() && resource.data.get('authorId', '') == request.auth.uid));
    }

    // ---------- eplShopItems (Developer full-site themes, tabs, widgets & mods) ----------
    match /eplShopItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isDeveloper()
                    && isValidEplShopItem(request.resource.data, itemId)
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if isValidId(itemId) && (
        (isDeveloper() && isValidEplShopItem(request.resource.data, itemId))
        || (signedIn()
            && isValidEplShopItem(request.resource.data, itemId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sales', 'updatedAt']))
      );
      allow delete: if isValidId(itemId) && isDeveloper();
    }

    // ---------- premium_codes: server only ----------
    match /premium_codes/{codeId} {
      allow read, write: if false;
    }

    // ---------- premiumCodes (admin list) ----------
    match /premiumCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    // ---------- premiumChats (Player <-> Developer chat) ----------
    match /premiumChats/{chatId} {
      allow get: if isValidId(chatId) && (isDeveloper() || isSelf(chatId));
      allow list: if isDeveloper() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(chatId)
                    && (isDeveloper() || isSelf(chatId))
                    && isValidPremiumChat(request.resource.data, chatId);
      allow update: if isValidId(chatId)
                    && (isDeveloper() || isSelf(chatId))
                    && isValidPremiumChat(request.resource.data, chatId);
      allow delete: if isValidId(chatId) && isDeveloper();

      match /messages/{messageId} {
        allow get, list: if isValidId(chatId) && isValidId(messageId) && (isDeveloper() || isSelf(chatId));
        allow create: if isValidId(chatId) && isValidId(messageId)
                      && (isDeveloper() || isSelf(chatId))
                      && isValidPremiumChatMessage(request.resource.data)
                      && request.resource.data.senderId == request.auth.uid
                      && (isDeveloper() || request.resource.data.senderRole == 'user');
        allow update, delete: if isValidId(chatId) && isValidId(messageId) && isDeveloper();
      }
    }

    // ---------- adminRequests ----------
    match /adminRequests/{reqId} {
      allow create: if isValidId(reqId) && signedIn()
                    && (request.resource.data.get('requesterId', '') == request.auth.uid || request.resource.data.get('uid', '') == request.auth.uid);
      allow get: if isValidId(reqId) && signedIn();
      allow list: if signedIn();
      allow update: if isValidId(reqId) && (
        isStaff()
        || (signedIn() && resource.data.get('requesterId', '') == request.auth.uid)
      );
      allow delete: if isValidId(reqId) && (
        isStaff()
        || (signedIn() && resource.data.get('requesterId', '') == request.auth.uid)
      );
    }

    // ---------- comments ----------
    match /comments/{commentId} {
      allow get: if isValidId(commentId);
      allow list: if true;
      allow create: if isValidId(commentId) && signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isValidId(commentId) && (isStaff() || (signedIn() && resource.data.userId == request.auth.uid));
    }

    // ---------- votes ----------
    match /votes/{voteId} {
      allow get: if isValidId(voteId);
      allow list: if true;
      allow create, update: if isValidId(voteId) && signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isValidId(voteId) && signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- reviews (Rate tab + app reviews; deletion strictly developer, author, or server AI) ----------
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isValidReview(request.resource.data);
      allow update: if isValidId(reviewId)
                    && (isDeveloper() || (signedIn() && resource.data.userId == request.auth.uid))
                    && isValidReview(request.resource.data);
      allow delete: if isValidId(reviewId)
                    && (isDeveloper() || (signedIn() && resource.data.userId == request.auth.uid));
    }

    // ---------- remoteControlSessions (Control My EPL) ----------
    match /remoteControlSessions/{targetUid} {
      allow get: if isValidId(targetUid) && signedIn()
                 && (isSelf(targetUid) || callerHasPremium());
      allow list: if signedIn()
                  && (isDeveloper() || resource.data.targetUid == request.auth.uid || resource.data.controllerUid == request.auth.uid);
      allow create: if isValidId(targetUid) && callerHasPremium()
                    && request.resource.data.controllerUid == request.auth.uid
                    && isValidRemoteSession(request.resource.data, targetUid);
      allow update: if isValidId(targetUid) && signedIn()
                    && isValidRemoteSession(request.resource.data, targetUid)
                    && (
                      (isSelf(targetUid) && request.resource.data.status in ['declined', 'ended'])
                      || (callerHasPremium() && request.resource.data.controllerUid == request.auth.uid)
                    );
      allow delete: if isValidId(targetUid) && signedIn()
                    && (isSelf(targetUid) || resource.data.controllerUid == request.auth.uid || isDeveloper());
    }

    // ---------- trollInbox (Troll Message & target prank FX) ----------
    match /trollInbox/{targetUid} {
      allow get: if isValidId(targetUid) && signedIn()
                 && (isSelf(targetUid) || callerHasPremium());
      allow list: if signedIn()
                  && (isDeveloper() || resource.data.targetUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
      allow create, update: if isValidId(targetUid) && signedIn()
                            && isValidTrollInbox(request.resource.data, targetUid)
                            && (isSelf(targetUid) || (callerHasPremium() && request.resource.data.senderUid == request.auth.uid));
      allow delete: if isValidId(targetUid) && (isSelf(targetUid) || isDeveloper());
    }

    // ---------- friendRequests ----------
    match /friendRequests/{requestId} {
      allow get, list: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isValidId(requestId) && signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isValidId(requestId) && signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // ---------- collabSessions ----------
    match /collabSessions/{sessionId} {
      allow get, list, create, update, delete: if signedIn();
    }

    // ---------- installed_apps ----------
    match /installed_apps/{installId} {
      allow get, list: if signedIn();
      allow create, update: if isValidId(installId) && signedIn() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
      allow delete: if isValidId(installId) && signedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    // ---------- aiModerationLogs ----------
    match /aiModerationLogs/{logId} {
      allow get, list: if signedIn();
      allow write: if isStaff();
    }

    // ---------- audit ----------
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------- news ----------
    match /news/{newsId} {
      allow get: if isValidId(newsId);
      allow list: if true;
      allow create: if isValidId(newsId) && isDeveloper()
                    && isValidNews(request.resource.data, newsId)
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if isValidId(newsId) && isDeveloper()
                    && isValidNews(request.resource.data, newsId)
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidId(newsId) && isDeveloper();
    }
  }
}
