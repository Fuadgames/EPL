rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function verified()  { return signedIn() && request.auth.token.email_verified == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin()   { 
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.developer == true ||
        request.auth.token.role in ['admin', 'developer']
      ); 
    }
    function isStaff() {
      return isAdmin() || (signedIn() && (request.auth.token.moderator == true || request.auth.token.role == 'moderator'));
    }

    // ---------- users ----------
    match /users/{userId} {
      allow get:    if isSelf(userId) || isStaff();
      allow list:   if isStaff();

      // Пользователь может создать свой начальный профиль
      allow create: if isSelf(userId)
                    && request.resource.data.get('uid', userId) == userId
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('isPremium', false) == false
                    && request.resource.data.get('eplCoins', 0) == 0
                    && request.resource.data.get('premiumExpiry', null) == null
                    && request.resource.data.get('isBanned', false) == false;

      // Обновление: пользователю разрешено менять безопасные поля (installedApps, installedAppsList, name, bio, etc.)
      // Привилегированные поля (role, isPremium, premiumExpiry, eplCoins, isBanned) неизменяемы с клиента
      allow update: if isStaff()
                    || (isSelf(userId)
                        && request.resource.data.get('role', 'user')          == resource.data.get('role', 'user')
                        && request.resource.data.get('isPremium', false)     == resource.data.get('isPremium', false)
                        && request.resource.data.get('premiumExpiry', null) == resource.data.get('premiumExpiry', null)
                        && request.resource.data.get('eplCoins', 0)          == resource.data.get('eplCoins', 0)
                        && request.resource.data.get('isBanned', false)      == resource.data.get('isBanned', false));

      allow delete: if isAdmin();
    }

    // ---------- users_public ----------
    match /users_public/{userId} {
      allow get, list: if true;
      allow create, update: if isStaff()
        || (isSelf(userId)
            && request.resource.data.get('uid', userId) == userId
            && request.resource.data.get('eplCoins', 0) == resource.data.get('eplCoins', 0)
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'));
      allow delete: if isAdmin();
    }

    // ---------- apps ----------
    match /apps/{appId} {
      allow get, list: if true;
      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if isStaff()
        || (signedIn()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isStaff()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // ---------- assets ----------
    match /assets/{assetId} {
      allow get, list: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isStaff()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // ---------- premium_codes: клиенту закрыто полностью ----------
    match /premium_codes/{codeId} {
      allow read, write: if false;   // Только Server / Admin SDK
    }

    // ---------- adminRequests ----------
    match /adminRequests/{reqId} {
      allow create: if signedIn()
                    && (request.resource.data.get('requesterId', '') == request.auth.uid || request.resource.data.get('uid', '') == request.auth.uid);
      allow read: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---------- comments ----------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- votes ----------
    match /votes/{voteId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---------- friendRequests ----------
    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // ---------- collabSessions ----------
    match /collabSessions/{sessionId} {
      allow read, write: if signedIn();
    }

    // ---------- installed_apps ----------
    match /installed_apps/{installId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
      allow delete: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    // ---------- aiModerationLogs ----------
    match /aiModerationLogs/{logId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---------- audit log: только сервер ----------
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false; // Только Admin SDK
    }

    // Всё остальное запрещено по умолчанию
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
