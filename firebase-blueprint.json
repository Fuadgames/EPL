{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the EPL Studio platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "name": { "type": "string", "description": "The user's display name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "photoUrl": { "type": "string", "format": "uri", "description": "The user's profile picture URL." },
        "role": { "type": "string", "enum": ["user", "admin", "moderator", "developer", "shopkeeper"], "description": "The user's role." },
        "isVerifiedAuthor": { "type": "boolean", "description": "Whether the user has the VERIFIED badge." },
        "isBanned": { "type": "boolean", "description": "Whether the user is banned." },
        "banReason": { "type": "string", "description": "Reason for user ban." },
        "roleVerification": { "type": "string", "description": "Role verification mark (e.g. Role is allowed by dev)." },
        "bio": { "type": "string", "description": "User bio." },
        "moderationStatus": { "type": "string", "description": "AI moderation status." },
        "moderationReason": { "type": "string", "description": "AI moderation reason." },
        "eplCoins": { "type": "number", "description": "The user's EPLCoins balance." },
        "purchasedItems": { "type": "array", "items": { "type": "string" }, "description": "List of purchased items." },
        "avatarUrl": { "type": "string", "format": "uri", "description": "The user's custom avatar URL." },
        "region": { "type": "string", "description": "The user's region for leaderboards." },
        "friends": { "type": "array", "items": { "type": "string" }, "description": "List of friend UIDs." },
        "friendCode": { "type": "string", "description": "Readable invite code for adding friends." },
        "isPremium": { "type": "boolean", "description": "Whether the user has an active premium tier." },
        "premiumTier": { "type": "string", "enum": ["none", "plus", "premium", "ultra"], "description": "Active premium subscription tier." },
        "premiumExpiry": { "type": "string", "format": "date-time", "description": "Premium expiration timestamp." },
        "activeEplShopItemId": { "type": ["string", "null"], "description": "Currently applied EPL Shop build ID." },
        "activeEplShopSpec": { "type": ["object", "null"], "description": "Currently applied EPL Shop full-site customization spec." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." }
      },
      "required": ["uid", "name", "email", "role", "eplCoins", "purchasedItems", "createdAt"]
    },
    "PremiumCode": {
      "title": "PremiumCode",
      "description": "One-time activation key bound to a specific premium tier.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "SHA-256 hash or unique ID of the code." },
        "code": { "type": "string", "description": "Redeemable code string." },
        "tier": { "type": "string", "enum": ["plus", "premium", "ultra"], "description": "Tier unlocked by this code." },
        "used": { "type": "boolean", "description": "Whether the code has already been redeemed." },
        "usedBy": { "type": "string", "description": "UID of the user who redeemed the code." },
        "usedAt": { "type": "string", "format": "date-time", "description": "Redemption timestamp." },
        "createdBy": { "type": "string", "description": "UID of admin/developer who generated the code." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["code", "tier", "used", "createdBy", "createdAt"]
    },
    "PremiumChat": {
      "title": "PremiumChat",
      "description": "Direct support & feedback chat thread between a player and the developer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user chatting with the developer." },
        "userName": { "type": "string", "description": "Display name of the user." },
        "userAvatar": { "type": "string", "description": "Avatar URL of the user." },
        "premiumTier": { "type": "string", "enum": ["none", "plus", "premium", "ultra"], "description": "User premium tier." },
        "lastMessage": { "type": "string", "description": "Latest message preview." },
        "lastSenderRole": { "type": "string", "enum": ["user", "developer"], "description": "Role of last sender." },
        "lastMessageAt": { "type": "string", "format": "date-time", "description": "Timestamp of last message." },
        "unreadForDev": { "type": "boolean", "description": "Whether the developer has unread messages." },
        "unreadForUser": { "type": "boolean", "description": "Whether the user has unread replies." }
      },
      "required": ["userId", "userName", "lastMessage", "lastMessageAt"]
    },
    "PremiumChatMessage": {
      "title": "PremiumChatMessage",
      "description": "Individual message inside a user-developer premium chat thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID." },
        "senderId": { "type": "string", "description": "UID of the sender." },
        "senderName": { "type": "string", "description": "Name of the sender." },
        "senderRole": { "type": "string", "enum": ["user", "developer"], "description": "Whether sent by player or developer." },
        "text": { "type": "string", "description": "Message body." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp." }
      },
      "required": ["senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "RemoteControlSession": {
      "title": "RemoteControlSession",
      "description": "Live Control My EPL remote control session targeting a user.",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "description": "Target user UID." },
        "targetName": { "type": "string", "description": "Target user name." },
        "controllerUid": { "type": "string", "description": "Controller user UID." },
        "controllerName": { "type": "string", "description": "Controller display name." },
        "status": { "type": "string", "enum": ["active", "declined", "ended"], "description": "Session state." },
        "command": { "type": "object", "description": "Latest command payload executed on target EPL." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["targetUid", "controllerUid", "controllerName", "status", "updatedAt"]
    },
    "TrollInbox": {
      "title": "TrollInbox",
      "description": "Latest real-time troll message or screen prank sent to a target user.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "description": "Unique ID of the latest prank/message event." },
        "targetUid": { "type": "string", "description": "Target user UID." },
        "senderUid": { "type": "string", "description": "Sender user UID." },
        "senderName": { "type": "string", "description": "Sender name." },
        "kind": { "type": "string", "enum": ["troll_message", "prank_fx", "soundboard", "clear"], "description": "Type of event." },
        "title": { "type": "string", "description": "Optional popup title." },
        "message": { "type": "string", "description": "Optional popup message body." },
        "style": { "type": "string", "description": "Visual style of the popup or prank." },
        "effect": { "type": "string", "description": "Screen effect name." },
        "durationMs": { "type": "number", "description": "Duration in milliseconds." },
        "sound": { "type": "string", "description": "Sound effect identifier." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp." }
      },
      "required": ["eventId", "targetUid", "senderUid", "kind", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A friend request between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The request ID." },
        "senderId": { "type": "string", "description": "The UID of the user sending the request." },
        "senderName": { "type": "string", "description": "The name of the sender." },
        "receiverId": { "type": "string", "description": "The UID of the user receiving the request." },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"], "description": "The status of the request." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the request was sent." }
      },
      "required": ["id", "senderId", "senderName", "receiverId", "status", "createdAt"]
    },
    "CollabSession": {
      "title": "CollabSession",
      "description": "A real-time collaboration session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The session ID (join code)." },
        "hostId": { "type": "string", "description": "The UID of the host." },
        "code": { "type": "string", "description": "The current code in the editor." },
        "participants": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "userId": { "type": "string" },
              "userName": { "type": "string" },
              "isTyping": { "type": "boolean" }
            }
          }, 
          "description": "List of participants." 
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the session was created." }
      },
      "required": ["id", "hostId", "code", "participants", "createdAt"]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public profile data for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "name": { "type": "string", "description": "The user's display name." },
        "avatarUrl": { "type": "string", "format": "uri", "description": "The user's custom avatar URL." },
        "region": { "type": "string", "description": "The user's region for leaderboards." },
        "eplCoins": { "type": "number", "description": "The user's EPLCoins balance." },
        "friendCode": { "type": "string", "description": "Readable invite code for adding friends." },
        "premiumTier": { "type": "string", "enum": ["none", "plus", "premium", "ultra"], "description": "Public premium tier badge." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." }
      },
      "required": ["uid", "name", "eplCoins", "createdAt"]
    },
    "App": {
      "title": "App",
      "description": "An application written in EPL and published to the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The app's unique ID." },
        "title": { "type": "string", "description": "The name of the app." },
        "description": { "type": "string", "description": "A description of what the app does." },
        "code": { "type": "string", "description": "The EPL source code of the app." },
        "version": { "type": "string", "description": "The version string, e.g., '1.0.0'." },
        "category": { "type": "string", "enum": ["games", "apps", "work", "AI", "Programming Language", "Store", "Other"], "description": "The app's category." },
        "supportedPlatforms": { "type": "array", "items": { "type": "string" }, "description": "List of supported platforms." },
        "windowsUrl": { "type": "string", "format": "uri", "description": "Download URL for Windows (.exe)." },
        "macosUrl": { "type": "string", "format": "uri", "description": "Download URL for MacOS (.app)." },
        "linuxUrl": { "type": "string", "format": "uri", "description": "Download URL for Linux." },
        "apkUrl": { "type": "string", "format": "uri", "description": "Download URL for Android (.apk)." },
        "authorId": { "type": "string", "description": "The UID of the user who created the app." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "downloads": { "type": "number", "description": "Number of times the app was run/downloaded." },
        "likes": { "type": "number", "description": "Number of likes." },
        "dislikes": { "type": "number", "description": "Number of dislikes." },
        "rating": { "type": "number", "description": "Average rating." },
        "isVerified": { "type": "boolean", "description": "Whether the app is verified." },
        "isWebsite": { "type": "boolean", "description": "Whether the project is published as an .epl website." },
        "websiteDomain": { "type": "string", "description": "Custom .epl domain assigned to the published website." },
        "hideWatermark": { "type": "boolean", "description": "Whether the Created in EPL Studio watermark is hidden (Premium)." },
        "comments": { "type": "array", "items": { "$ref": "#/entities/Comment" }, "description": "Comments on the app." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the app was published." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the app was last updated." }
      },
      "required": ["title", "description", "code", "version", "category", "authorId", "authorName", "downloads", "likes", "dislikes", "rating", "isVerified", "createdAt", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on an app.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who wrote the comment." },
        "userName": { "type": "string", "description": "The name of the user." },
        "text": { "type": "string", "description": "The comment text." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the comment was posted." }
      },
      "required": ["userId", "userName", "text", "createdAt"]
    },
    "UserVote": {
      "title": "UserVote",
      "description": "A user's vote (like/dislike) on an app.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user." },
        "appId": { "type": "string", "description": "The ID of the app." },
        "type": { "type": "string", "enum": ["like", "dislike"], "description": "The type of vote." }
      },
      "required": ["userId", "appId", "type"]
    },
    "Review": {
      "title": "Review",
      "description": "A user rating and review for the game/platform or an app.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The review's unique ID." },
        "appId": { "type": "string", "description": "The ID of the app or 'platform' for overall EPL Studio review." },
        "userId": { "type": "string", "description": "The UID of the user writing the review." },
        "userName": { "type": "string", "description": "The name of the user writing the review." },
        "userAvatar": { "type": "string", "description": "The avatar URL of the reviewer." },
        "userRole": { "type": "string", "description": "The role of the reviewer." },
        "premiumTier": { "type": "string", "description": "Premium tier of the reviewer." },
        "rating": { "type": "number", "description": "Rating from 1 to 5." },
        "comment": { "type": "string", "description": "The review text." },
        "aiChecked": { "type": "boolean", "description": "Whether checked by AI Moderator." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the review was posted." }
      },
      "required": ["appId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "Asset": {
      "title": "Asset",
      "description": "An item in the Asset Store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The asset's unique ID." },
        "title": { "type": "string", "description": "The name of the asset." },
        "description": { "type": "string", "description": "A description of what the asset does." },
        "coverUrl": { "type": "string", "format": "uri", "description": "Cover image URL." },
        "price": { "type": "number", "description": "Price in EPLCoins." },
        "stock": { "type": ["number", "string"], "description": "Number of items available or 'infinite'." },
        "authorId": { "type": "string", "description": "The UID of the user who created the asset." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "type": { "type": "string", "enum": ["style", "mod", "editor", "inventory"], "description": "The type of asset." },
        "content": { "type": "string", "description": "The code or JSON content of the asset." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the asset was published." }
      },
      "required": ["id", "title", "description", "price", "stock", "authorId", "authorName", "type", "content", "createdAt"]
    },
    "InstalledApp": {
      "title": "InstalledApp",
      "description": "An application installed by a user into their library.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user's UID." },
        "projectId": { "type": "string", "description": "The app's unique ID." },
        "projectName": { "type": "string", "description": "The title of the app." },
        "version": { "type": "string", "description": "The version string." },
        "installedAt": { "type": "string", "format": "date-time", "description": "When the app was installed." },
        "icon": { "type": "string", "description": "The app icon URL." },
        "status": { "type": "string", "enum": ["ready", "installed", "updating"], "description": "Installation status." }
      },
      "required": ["userId", "projectId", "projectName", "version", "installedAt", "status"]
    },
    "News": {
      "title": "News",
      "description": "Platform news and announcements published exclusively by developers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The news post unique ID." },
        "title": { "type": "string", "description": "The headline of the news post." },
        "content": { "type": "string", "description": "Formatted rich-text body supporting bold, italic/curve, underline, and code highlights." },
        "font": { "type": "string", "enum": ["sans", "serif", "mono", "display", "cursive"], "description": "Typography family selected for the post." },
        "images": { "type": "array", "items": { "type": "string" }, "description": "Optional attached image URLs or compressed data URLs." },
        "authorId": { "type": "string", "description": "The UID of the developer who authored the post." },
        "authorName": { "type": "string", "description": "The display name of the author." },
        "authorAvatar": { "type": "string", "description": "Optional avatar URL of the author." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the news post was published." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the news post was last updated." }
      },
      "required": ["id", "title", "content", "font", "images", "authorId", "authorName", "createdAt", "updatedAt"]
    },
    "EplShopItem": {
      "title": "EplShopItem",
      "description": "A developer-built full-site theme, navigation layout, and EPL widget customization pack in EPL Shop.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique shop item ID." },
        "title": { "type": "string", "description": "Display title of the site customization pack." },
        "description": { "type": "string", "description": "Description of what this EPL Shop build changes." },
        "coverUrl": { "type": "string", "description": "Cover image URL or compressed data URL." },
        "screenshotUrl": { "type": "string", "description": "Preview screenshot data URL." },
        "price": { "type": "number", "description": "Price in EPLCoins." },
        "stock": { "type": ["number", "string"], "description": "Remaining stock count or 'infinite'." },
        "sales": { "type": "number", "description": "Total purchase count." },
        "authorId": { "type": "string", "description": "Developer UID." },
        "authorName": { "type": "string", "description": "Author display name." },
        "spec": { "type": "object", "description": "EplSiteCustomizationSpec JSON payload." },
        "status": { "type": "string", "enum": ["active", "draft", "archived"], "description": "Listing visibility status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["id", "title", "price", "stock", "authorId", "authorName", "spec", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/installed_apps/{installId}": {
      "schema": { "$ref": "#/entities/InstalledApp" },
      "description": "Stores user installed applications."
    },
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Stores public user profiles."
    },
    "/apps/{appId}": {
      "schema": { "$ref": "#/entities/App" },
      "description": "Stores published apps."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Stores platform and app reviews."
    },
    "/votes/{voteId}": {
      "schema": { "$ref": "#/entities/UserVote" },
      "description": "Stores user votes on apps."
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "Stores assets in the Asset Store."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Stores friend requests."
    },
    "/collabSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CollabSession" },
      "description": "Stores real-time collaboration sessions."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/News" },
      "description": "Stores developer-authored news and announcements."
    },
    "/premiumCodes/{codeId}": {
      "schema": { "$ref": "#/entities/PremiumCode" },
      "description": "Stores generated tiered premium activation codes."
    },
    "/premiumChats/{chatId}": {
      "schema": { "$ref": "#/entities/PremiumChat" },
      "description": "Stores player-to-developer premium support chat threads."
    },
    "/premiumChats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/PremiumChatMessage" },
      "description": "Stores messages inside a player-developer chat thread."
    },
    "/remoteControlSessions/{targetUid}": {
      "schema": { "$ref": "#/entities/RemoteControlSession" },
      "description": "Stores real-time Control My EPL remote control sessions."
    },
    "/trollInbox/{targetUid}": {
      "schema": { "$ref": "#/entities/TrollInbox" },
      "description": "Stores incoming Troll Message and prank FX payloads for users."
    },
    "/eplShopItems/{itemId}": {
      "schema": { "$ref": "#/entities/EplShopItem" },
      "description": "Stores developer-published full-site EPL Shop themes, tabs, widgets, and mods."
    }
  }
}
